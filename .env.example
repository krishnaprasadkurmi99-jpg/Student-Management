# Copy this file to .env for local PostgreSQL development.
# Set the password locally; do not commit .env or share the password.
DATABASE_URL=
CAMPUSLY_DB_HOST=localhost
CAMPUSLY_DB_PORT=5432
CAMPUSLY_DB_NAME=campusly
CAMPUSLY_DB_USER=postgres
CAMPUSLY_DB_PASSWORD=

# Optional. If omitted, the application generates a local development key.
# Set a stable, long random value for deployments.
SECRET_KEY=
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0
